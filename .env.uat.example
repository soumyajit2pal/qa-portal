# Safe template only. Copy to .env.uat, chmod it 600, and replace every
# empty/placeholder value. Never commit the populated profile.
APP_ENV=uat
APP_ENV_FILE=.env.uat
IMAGE_TAG=uat

# Oracle connection URL, for example:
# oracle+oracledb://QA_PORTAL:password@oracle-uat.example.com:1521/?service_name=ORCLPDB1
DATABASE_URL=
SECRET_KEY=
# Optional dedicated integrity secret (32+ characters). Keep stable across workers/redeployments.
# If blank, signature seals use a key derived from SECRET_KEY.
SIGNATURE_INTEGRITY_KEY=

LOGIN_ENCRYPTION_KEY_HOST_DIR=./secrets
LOGIN_ENCRYPTION_PRIVATE_KEY_FILE=login-private.pem
QA_CERTIFICATE_SIGNING_PRIVATE_KEY_FILE=certificate-signing-private.pem
QA_CERTIFICATE_SIGNING_KEY_ID=qualityops-issuer-2026-01
QA_CERTIFICATE_TRUSTED_PUBLIC_KEYS_DIR=certificate-trusted
QA_CERTIFICATE_VERIFICATION_BASE_URL=https://qualityops-uat.example/verify-certificate
TLS_CERT_HOST_PATH=./certs
UPLOAD_STORAGE_HOST_PATH=./storage
DOCUMENT_PORTAL_STORAGE_HOST_PATH=./storage/document-portal

WEB_CONCURRENCY=4
DOCUMENT_PORTAL_WEB_CONCURRENCY=2
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_QUERY_TIMEOUT_MS=30000
AUDIT_DB_POOL_SIZE=3
AUDIT_DB_MAX_OVERFLOW=2

# Matches docker-compose.static-ip.yml's default nginx address. Override both
# values together if the subnet conflicts with the deployment network.
PORTAL_SUBNET=172.30.50.0/24
PORTAL_GATEWAY=172.30.50.1
PORTAL_NGINX_IP=172.30.50.10
FORWARDED_ALLOW_IPS=172.30.50.10
# Audit/rate-limit client-IP resolver. Add an upstream load balancer only when
# it is controlled and configured to overwrite incoming forwarding headers.
TRUSTED_PROXY_CIDRS=172.30.50.10/32,127.0.0.1/32,::1/128
# Required for non-local access: set this to the portal's real external DNS
# name or IP. The backend automatically appends it to TRUSTED_HOSTS.
DOMAIN_NAME=
TRUSTED_HOSTS=localhost,127.0.0.1,backend,document_portal,document-portal
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=true
SESSION_MAX_MINUTES=480
SESSION_IDLE_MINUTES=30

REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
# Evictable read cache and durable jobs/login coordination are separate servers.
REDIS_CACHE_MAXMEMORY=256mb
REDIS_CACHE_CONTAINER_MEMORY=512m
REDIS_COORDINATION_URL=redis://redis_coordination:6379/0
REDIS_COORDINATION_MAXMEMORY=256mb
REDIS_COORDINATION_CONTAINER_MEMORY=512m
CACHE_MAX_CONNECTIONS=32
CACHE_SOCKET_CONNECT_TIMEOUT_SECONDS=0.25
CACHE_SOCKET_TIMEOUT_SECONDS=0.25
CACHE_INIT_RETRY_SECONDS=15
CACHE_FILL_LOCK_TTL_SECONDS=15
CACHE_FILL_WAIT_SECONDS=0.15
DASHBOARD_CACHE_TTL_SECONDS=30
REDIS_COORDINATION_MAX_CONNECTIONS=24
REDIS_COORDINATION_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_COORDINATION_SOCKET_TIMEOUT_SECONDS=1
JOB_QUEUE_BACKEND=redis
BACKGROUND_JOB_WORKERS=2
BACKGROUND_JOB_GLOBAL_CONCURRENCY=2
BACKGROUND_JOB_LEASE_SECONDS=120
BACKGROUND_JOB_POLL_SECONDS=2
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_RETENTION_SECONDS=604800
JOB_WORKER_DB_POOL_SIZE=2
JOB_WORKER_DB_MAX_OVERFLOW=1
NOTIFICATION_WORKER_MODE=dedicated
NOTIFICATION_WORKER_DB_POOL_SIZE=2
NOTIFICATION_WORKER_DB_MAX_OVERFLOW=1
LOGIN_RATE_LIMIT_BACKEND=redis
DEEP_LOGGING=false
LOG_DIR=/app/logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SLOW_REQUEST_MS=2000

SMTP_ENABLED=false
LDAP_MOCK_ENABLED=false

# Bootstrap/recovery LDAP values used only until Admin saves a database-backed
# configuration. Real LDAP uses certificate-verified LDAPS. The Admin UI can
# upload a PEM/DER .cer/.crt/.pem CA certificate into the database; it takes
# precedence and needs no writable mount. Do not use a client workstation path.
# Optional legacy/bootstrap path inside the container:
# LDAP_CA_CERT_FILE=/run/secrets/qualityops/ldap-ca.pem
# Place that PEM in LOGIN_ENCRYPTION_KEY_HOST_DIR for the read-only Compose mount.
LDAP_SERVER_URI=ldaps://directory.example:636
LDAP_USE_SSL=true
LDAP_CA_CERT_FILE=
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_BIND_DN=cn=qualityops-bind,ou=service-accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=
# Alternative to LDAP_BIND_DN + LDAP_BASE_DN:
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
