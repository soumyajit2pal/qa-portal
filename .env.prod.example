# Safe template only. Copy to .env.prod, chmod it 600, and inject real values
# from the deployment secret store. Never commit the populated profile.
APP_ENV=prod
APP_ENV_FILE=.env.prod
IMAGE_TAG=

DATABASE_URL=
SECRET_KEY=

LOGIN_ENCRYPTION_KEY_HOST_DIR=./secrets
LOGIN_ENCRYPTION_PRIVATE_KEY_FILE=login-private.pem
TLS_CERT_HOST_PATH=./certs
UPLOAD_STORAGE_HOST_PATH=./storage
DOCUMENT_PORTAL_STORAGE_HOST_PATH=./storage/document-portal

WEB_CONCURRENCY=4
DOCUMENT_PORTAL_WEB_CONCURRENCY=2
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_QUERY_TIMEOUT_MS=30000
AUDIT_DB_POOL_SIZE=3
AUDIT_DB_MAX_OVERFLOW=2

# Matches docker-compose.static-ip.yml's default nginx address. Override both
# values together if the subnet conflicts with the deployment network.
PORTAL_SUBNET=172.30.50.0/24
PORTAL_GATEWAY=172.30.50.1
PORTAL_NGINX_IP=172.30.50.10
FORWARDED_ALLOW_IPS=172.30.50.10
# Audit/rate-limit client-IP resolver. Add an upstream load balancer only when
# it is controlled and configured to overwrite incoming forwarding headers.
TRUSTED_PROXY_CIDRS=172.30.50.10/32
# Required: set this to the production portal's real external DNS name or IP.
# The backend automatically appends it to TRUSTED_HOSTS.
DOMAIN_NAME=
TRUSTED_HOSTS=localhost,127.0.0.1,backend,document_portal
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=true
SESSION_MAX_MINUTES=480
SESSION_IDLE_MINUTES=30

REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
DEEP_LOGGING=false
LOG_DIR=/app/logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SLOW_REQUEST_MS=2000

SMTP_ENABLED=false
LDAP_MOCK_ENABLED=false

# Bootstrap/recovery LDAP values used only until Admin saves a database-backed
# configuration. Real LDAP uses certificate-verified LDAPS. Place this CA
# PEM in LOGIN_ENCRYPTION_KEY_HOST_DIR for the existing read-only secret mount.
LDAP_SERVER_URI=ldaps://directory.example:636
LDAP_USE_SSL=true
LDAP_CA_CERT_FILE=/run/secrets/qualityops/ldap-ca.pem
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_BIND_DN=cn=qualityops-bind,ou=service-accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=
# Alternative to LDAP_BIND_DN + LDAP_BASE_DN:
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
