# Example overrides to merge into a complete root .env.prod. Supply all
# secrets through the protected deployment copy or secrets manager.
APP_ENV=prod
APP_ENV_FILE=.env.prod
# Certificate directory on the Production machine. It must contain the stable
# filenames qualityops.crt and qualityops.key.
TLS_CERT_HOST_PATH=./certs/
DEEP_LOGGING=false
DOCUMENT_PORTAL_WEB_CONCURRENCY=2
DOCUMENT_PORTAL_STORAGE_HOST_PATH=/mnt/qualityops/document-portal
