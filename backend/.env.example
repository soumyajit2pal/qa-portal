# Copy to .env and adjust. Loaded automatically on startup via python-dotenv
# (or export these as real environment variables in your shell / deployment).

# Oracle connection string (required -- the app will not start without it).
# Production example:
#   DATABASE_URL=oracle+oracledb://QA_PORTAL:your_password@dbhost:1521/?service_name=ORCLPDB1
# Local Oracle Database Free / XE via Docker (see README "Local Oracle for development"):
DATABASE_URL=oracle+oracledb://qa_portal:qa_portal_pwd@localhost:1521/?service_name=FREEPDB1

# Alembic reads this same DATABASE_URL. See backend/MIGRATIONS.md before the
# one-time baseline stamp or before creating/applying a schema revision.

SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Workflow email notifications (disabled until SMTP details are supplied) ---
SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=qa-portal@example.com
# SMTP_PASSWORD=replace-with-secret
# SMTP_FROM_ADDRESS=qa-portal@example.com
# SMTP_FROM_NAME=QA Portal
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_TIMEOUT_SECONDS=15
# PORTAL_BASE_URL=https://qa-portal.example.com

# --- Centralized logging ---
# false: normal production INFO/warning/error logs.
# true: temporary DEBUG diagnostics including correlated API timings,
#       SQL text with bind values hidden, and DB connection-pool activity.
# Restart every backend worker after changing this value.
DEEP_LOGGING=false
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SLOW_REQUEST_MS=2000

# --- Upload storage (Docker/production) ---
# Uploads always use this container path. In the root Compose .env,
# UPLOAD_STORAGE_HOST_PATH may be set to an absolute host/NFS directory;
# otherwise Docker uses its named volume.
UPLOAD_STORAGE_ROOT=/data/qualityops/uploads
# UPLOAD_STORAGE_HOST_PATH=/mnt/qualityops/uploads

# --- Isolated Document Portal ---
# The Compose document_portal service overrides DOCUMENT_PORTAL_ROOT and
# mounts this repository separately from core request/evidence uploads.
# Set DOCUMENT_PORTAL_STORAGE_HOST_PATH in the root Compose .env to a
# dedicated disk or NFS export; otherwise the qa_portal_documents volume is
# used. Keep this data under the bank's backup/retention policy.
# DOCUMENT_PORTAL_STORAGE_HOST_PATH=/mnt/qualityops/document-portal
# DOCUMENT_PORTAL_WEB_CONCURRENCY=2
# DOCUMENT_PORTAL_DB_POOL_SIZE=2
# DOCUMENT_PORTAL_DB_MAX_OVERFLOW=1
DOCUMENT_PORTAL_MAX_FILE_SIZE=524288000
DOCUMENT_PORTAL_MINIMUM_FREE_BYTES=104857600
# DOCUMENT_PORTAL_ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.png
# DOCUMENT_PORTAL_BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.sh,.ps1,.dll,.com,.msi,.scr

# --- Oracle connection pool (optional -- defaults shown below match prior
#     hardcoded behavior). Each API worker process gets its own pool, so
#     divide your DB's max-session budget across worker count when running
#     multiple workers (see INF-001). ---
# Safe per-worker starting point for the Dockerfile's four core workers.
# Size this together with WEB_CONCURRENCY against Oracle's approved session
# budget; see README's "Production Oracle pool capacity" section.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_QUERY_TIMEOUT_MS=30000

# --- Dependency circuit breakers ---
# After repeated dependency failures, each API worker fails fast instead of
# filling its worker/connection pool. One half-open probe is allowed after
# the recovery period; a successful probe closes the breaker automatically.
DATABASE_CIRCUIT_FAILURE_THRESHOLD=3
DATABASE_CIRCUIT_RECOVERY_SECONDS=20
REDIS_CIRCUIT_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_RECOVERY_SECONDS=15
SMTP_CIRCUIT_FAILURE_THRESHOLD=3
SMTP_CIRCUIT_RECOVERY_SECONDS=60
FORTIFY_CIRCUIT_FAILURE_THRESHOLD=3
FORTIFY_CIRCUIT_RECOVERY_SECONDS=60

# --- Audit-write connection pool (optional -- separate, deliberately
#     smaller pool used only for the per-request audit log write, so it
#     never competes with real request handling for DB_POOL_SIZE above.
#     See database.py's own comment.) ---
AUDIT_DB_POOL_SIZE=3

# Maximum database-backed export/import jobs per backend worker. Keep this
# below the main pool capacity so interactive workflow traffic always has DB
# connections available. The default is 2 (allowed range: 1-4).
BACKGROUND_JOB_WORKERS=2
AUDIT_DB_MAX_OVERFLOW=5

# --- Redis cache (optional -- dashboard summary + reference-data caching,
#     see backend/app/cache.py). Leave REDIS_URL unset to run without a
#     cache; nothing else needs to change. ---
# REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true

# --- LDAP / Active Directory login (only needed for users created with
#     login_type=LDAP from the Admin section; Standard accounts ignore these) ---
# LDAP_SERVER_URI=ldaps://ldap.bankofmaharashtra.bank.in:636
# LDAP_USE_SSL=true
# LDAP_BASE_DN=dc=bankofmaharashtra,dc=bank,dc=in
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
#
# Strategy 1 (recommended) -- search-then-bind via a read-only service account:
# LDAP_BIND_DN=cn=svc-qaportal,ou=service-accounts,dc=bankofmaharashtra,dc=bank,dc=in
# LDAP_BIND_PASSWORD=service-account-password
#
# Strategy 2 -- direct bind using a fixed DN template (no service account needed):
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=bankofmaharashtra,dc=bank,dc=in
# Reverse proxies allowed to supply the original client address. Replace or
# extend these with the production load-balancer/ingress network.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# Fortify SSC result import used by SAST/DAST Start Scan. Keep credentials
# server-side; never expose them through frontend VITE_* variables.
FORTIFY_SSC_URL=https://fortify-ssc.example.com/ssc
FORTIFY_SSC_AUTH=base64-basic-auth-value
FORTIFY_SSC_TIMEOUT_SECONDS=25
FORTIFY_SSC_VERIFY_TLS=true
# SAST and DAST on a DIFFERENT Fortify SSC instance/credentials? Set these --
# FortifySSCClient checks FORTIFY_SSC_{SAST,DAST}_URL/_AUTH first and only
# falls back to the shared FORTIFY_SSC_URL/_AUTH above if a kind-specific
# one isn't set (see fortify_ssc.py's FortifySSCClient.__init__). Leave
# commented out to use the same shared instance for both, as above.
# FORTIFY_SSC_SAST_URL=https://fortify-ssc-sast.example.com/ssc
# FORTIFY_SSC_SAST_AUTH=base64-basic-auth-value-sast
# FORTIFY_SSC_DAST_URL=https://fortify-ssc-dast.example.com/ssc
# FORTIFY_SSC_DAST_AUTH=base64-basic-auth-value-dast
# No live SSC access? Run `python3 scripts/mock_fortify_ssc.py` and point at
# it instead -- see that file's docstring for pre-seeded demo apps/versions.
# One shared mock covers both SAST and DAST fine (they're independent HTTP
# calls either way), but if you want to simulate genuinely separate SAST/DAST
# instances, run two mock processes on different ports and use the
# SAST/DAST-specific vars above to point each kind at its own:
#   python3 scripts/mock_fortify_ssc.py --port 8089   # SAST
#   python3 scripts/mock_fortify_ssc.py --port 8090   # DAST
# FORTIFY_SSC_URL=http://127.0.0.1:8089
# FORTIFY_SSC_AUTH=bW9jazptb2Nr
# FORTIFY_SSC_VERIFY_TLS=false
# FORTIFY_SSC_SAST_URL=http://127.0.0.1:8089
# FORTIFY_SSC_DAST_URL=http://127.0.0.1:8090
