# Backend API (used by the Vite dev proxy -- see vite.config.ts server.proxy).
VITE_BACKEND_URL=http://localhost:8000

# Where each module's built remoteEntry.js is served from. Local dev
# defaults (each module's own `npm run dev`/`npm run preview` port) are
# baked into vite.config.ts as fallbacks, so this file is only needed when
# a module is running somewhere other than localhost -- e.g. pointing the
# shell at a module deployed to staging/prod, or at another developer's
# machine on the LAN.
VITE_FUNCTIONAL_REMOTE_URL=http://localhost:5001/assets/remoteEntry.js
VITE_SECURITY_REMOTE_URL=http://localhost:5002/assets/remoteEntry.js
VITE_SPECIALISED_TESTING_REMOTE_URL=http://localhost:5003/assets/remoteEntry.js
VITE_GOVERNANCE_REMOTE_URL=http://localhost:5004/assets/remoteEntry.js
