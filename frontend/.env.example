# Local dev only -- where the Vite dev server proxies /api/* to (see
# vite.config.ts server.proxy). Not read at runtime by the built app.
VITE_BACKEND_URL=http://localhost:8000

# Production build only -- the fetch base URL baked into the built app (see
# src/api.ts). Leave unset (defaults to '') if nginx/your reverse proxy
# serves the frontend and forwards /api/* to the backend from the SAME
# origin (this is what nginx.conf + docker-compose.yml do). Set this only
# if the frontend and backend are served from different origins/hosts.
# VITE_API_BASE_URL=https://api.example.com
