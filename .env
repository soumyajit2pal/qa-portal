# Copy to .env and adjust. Loaded automatically on startup via python-dotenv
# (or export these as real environment variables in your shell / deployment).

# Active application profile and the complete environment file Compose passes
# to every Python service. Use .env.dev, .env.uat, or .env.prod in deployments.
APP_ENV=uat
APP_ENV_FILE=.env
TLS_CERT_HOST_PATH=./certs/

## Copy to .env and adjust. Loaded automatically on startup via python-dotenv
# (or export these as real environment variables in your shell / deployment).

# Oracle connection string (required -- the app will not start without it).
# Production example:
#   DATABASE_URL=oracle+oracledb://QA_PORTAL:your_password@dbhost:1521/?service_name=ORCLPDB1
# Local Oracle Database Free / XE via Docker (see README "Local Oracle for development"):
# DATABASE_URL=sqlite:///ORCLPDB1.db


# --- LDAP / Active Directory login (only needed for users created with
#     login_type=LDAP from the Admin section; Standard accounts ignore these) ---
# LDAP_SERVER_URI=ldaps://ldap.bankofmaharashtra.bank.in:636
# LDAP_USE_SSL=true
# LDAP_BASE_DN=dc=bankofmaharashtra,dc=bank,dc=in
# LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
#
# Strategy 1 (recommended) -- search-then-bind via a read-only service account:
# LDAP_BIND_DN=cn=svc-qaportal,ou=service-accounts,dc=bankofmaharashtra,dc=bank,dc=in
# LDAP_BIND_PASSWORD=service-account-password
#
# Strategy 2 -- direct bind using a fixed DN template (no service account needed):
# LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=bankofmaharashtra,dc=bank,dc=in

# Main Oracle pool—each Uvicorn worker creates its own pool
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_QUERY_TIMEOUT_MS=30000

# Separate audit-write pool
AUDIT_DB_POOL_SIZE=3
AUDIT_DB_MAX_OVERFLOW=4

# REDIS_URL=redis://redis:6379/0
# CACHE_ENABLED=true
LOG_DIR=/app/logs
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SLOW_REQUEST_MS=2000

FORTIFY_SSC_URL=http://127.0.0.1:8089
FORTIFY_SSC_AUTH=bW9jazptb2Nr
FORTIFY_SSC_VERIFY_TLS=true


DATABASE_CIRCUIT_FAILURE_THRESHOLD=3
DATABASE_CIRCUIT_RECOVERY_SECONDS=20
REDIS_CIRCUIT_FAILURE_THRESHOLD=3
REDIS_CIRCUIT_RECOVERY_SECONDS=15
SMTP_CIRCUIT_FAILURE_THRESHOLD=3
SMTP_CIRCUIT_RECOVERY_SECONDS=60
FORTIFY_CIRCUIT_FAILURE_THRESHOLD=3
FORTIFY_CIRCUIT_RECOVERY_SECONDS=60
SECRET_KEY=-_rvjdBWHYVSiSPQP9CoeYUTgLEIBQbBr8JID6XInHOCrKZKtpeQZ1ZkgXmWRlVM
